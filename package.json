{
  "name": "@paradigmmachines/orion",
  "version": "0.3.0",
  "description": "Fine-grained input telemetry on top of PostHog, with live sentiment labels for your agents",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./analysis": "./src/analysis.js",
    "./codec": {
      "types": "./src/codec.d.ts",
      "import": "./src/codec.js"
    },
    "./auto": "./src/auto.js"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "README.md",
    "docs",
    "recipes",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/browser-test.js",
    "check": "npm run build && npm test && npm run test:browser",
    "demo": "node scripts/serve.js",
    "prepack": "npm run build",
    "test:training": ".venv/bin/python -m unittest discover -s test/training -v",
    "test:python": ".venv/bin/python -m unittest discover -s test/training -v"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "onnxruntime-web": "1.30.0",
    "playwright": "1.56.1",
    "posthog-js": "1.280.0",
    "posthog-js-current": "npm:posthog-js@1.438.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanlin10/orion-posthog.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "posthog",
    "telemetry",
    "sentiment",
    "session-replay",
    "agents"
  ]
}
