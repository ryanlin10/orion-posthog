{
  "version": 1,
  "name": "custom-multitask-sequences",
  "targets": {
    "states": {"type": "multilabel", "classes": ["frustrated", "curious", "focused", "satisfied"]},
    "valence": {"type": "continuous", "min": -1, "max": 1}
  },
  "window": {"mode": "sliding", "size_ms": 10000, "stride_ms": 5000},
  "labels": {"sources": ["human", "self_report"], "min_confidence": 0.8},
  "features": {"families": ["keyboard", "pointer", "scroll"]},
  "output": {"include_sequence": true}
}
